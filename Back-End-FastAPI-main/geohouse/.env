# ──────────────────────────────────────────────
# GEO HOUSE — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA versione o .env no git
# ──────────────────────────────────────────────

# Banco de dados SQLite — caminho do arquivo
DB_PATH=./geo_house.db

# JWT — gere uma chave segura com:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=TROQUE_POR_UMA_CHAVE_SEGURA
ALGORITHM=HS256
ACCESS_TOKEN_EXP=30
REFRESH_TOKEN_EXP=10080

# Aplicação
APP_NAME=GEO HOUSE API
APP_VERSION=1.0.0
DEBUG=False
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Upload de fotos
UPLOAD_DIR=uploads/fotos
MAX_UPLOAD_MB=5